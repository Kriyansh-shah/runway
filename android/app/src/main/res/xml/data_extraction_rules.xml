<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to Google backup or a new phone. Runway's data
     is encrypted with Keystore keys that never leave this phone, so a
     restored copy could never be opened (and the app hung on launch trying).
     Moving to a new phone is done with encrypted Budget sync instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
